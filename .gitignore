# Ambiente e segredos
# Nenhuma variação de arquivo de ambiente é versionada, exceto os modelos
# (.env.example e .env.local.example), que existem justamente para documentar
# as variáveis — e nunca contêm segredo.
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
credentials.json
secrets.json

# Ambientes virtuais
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Django
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
*.log

# Artefatos de execução de testes e verificação (saída redirecionada)
.suite_out.txt
/local_data/carga_historica/

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Referências temporárias de template (não fazem parte do produto)
.vendor_ref/
