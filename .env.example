# Eithra — variáveis de ambiente (nenhum segredo real neste arquivo)
# Copie para ".env" e preencha localmente. O arquivo ".env" não vai para o Git.

# Chave secreta do Django. Em produção é obrigatória.
DJANGO_SECRET_KEY=

# Liga/desliga o modo de depuração. Em produção deve ser False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Banco de dados (obrigatório em todos os ambientes)
# ---------------------------------------------------------------------------
# O Eithra usa PostgreSQL. Não existe banco padrão nem fallback para SQLite:
# sem esta variável o ambiente não sobe.
#
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Para conexões que exigem TLS, acrescente o parâmetro de SSL na própria URL
# (ex.: ?sslmode=require). Nada de host, porta, usuário, senha ou SSL fica
# escrito no código.
#
# NUNCA coloque a conexão real neste arquivo — somente no seu ".env".
DATABASE_URL=

# ---------------------------------------------------------------------------
# E-mail transacional
# ---------------------------------------------------------------------------
# O Eithra pode enviar o link de primeiro acesso e de troca de senha por e-mail.
# Em desenvolvimento local, o backend pode continuar sendo o console; em
# produção, configure SMTP ou outro backend equivalente no ambiente.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Somente produção: força redirecionamento HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False

# Somente produção: tempo (em segundos) de HSTS.
DJANGO_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Arquivos de balanço (storage externo privado)
# ---------------------------------------------------------------------------
# O PDF de um balanço é privado: fica em bucket privado, nunca no disco da
# aplicação. O banco guarda só a referência do objeto.
#
# DEV e PROD usam buckets separados. Sem estas variáveis, o envio é recusado —
# não há queda silenciosa para o sistema de arquivos local.
BALANCOS_STORAGE_PROVIDER=supabase
BALANCOS_STORAGE_BUCKET=

# Tamanho máximo aceito para um arquivo de balanço, em bytes (padrão: 50 MB).
BALANCOS_MAX_UPLOAD_BYTES=52428800

# Validade, em segundos, do acesso temporário ao arquivo (padrão: 60).
BALANCOS_URL_ACESSO_SEGUNDOS=60

# Quantidade máxima de páginas da abertura lidas para detectar o layout
# (padrão: 15). A amostra é a abertura estrutural, não o arquivo inteiro.
BALANCOS_DETECTOR_MAX_PAGINAS=15

# ---------------------------------------------------------------------------
# Documentos operacionais (storage externo privado)
# ---------------------------------------------------------------------------
# Mesmo provedor e mesmas credenciais dos balanços, em bucket privado próprio:
# o arquivo de um domínio não fica no bucket de outro.
DOCUMENTOS_STORAGE_BUCKET=

# Credenciais do provedor de storage. Somente backend: nunca no frontend,
# nunca versionadas. A service role key dá acesso total ao bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
