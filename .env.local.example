# Eithra — modelo do ambiente LOCAL (nenhum segredo real neste arquivo)
#
# Este modelo serve para trabalhar contra o PostgreSQL local, sem tocar no
# ambiente remoto. Copie para ".env.local" e preencha a senha do banco local:
#
#     Copy-Item .env.local.example .env.local
#
# O arquivo ".env.local" não vai para o Git (veja .gitignore). A senha real
# existe só nele, nunca aqui, nunca nos scripts, nunca no código.
#
# Para subir o servidor e rodar testes com este ambiente, use os scripts da
# raiz — eles selecionam este arquivo e conferem o alvo antes de executar:
#
#     .\run-local.ps1
#     .\test-local.ps1 apps.cadastros
#
# Documentação: docs/ambiente_postgresql_local.md

# Qual arquivo de ambiente o Django deve ler. Os scripts já definem esta
# variável; ela aparece aqui como referência do que está sendo selecionado.
EITHRA_ENV_FILE=.env.local

# ---------------------------------------------------------------------------
# Banco de dados local
# ---------------------------------------------------------------------------
# O Eithra usa PostgreSQL. Não existe banco padrão nem fallback para SQLite:
# sem esta variável o ambiente não sobe.
#
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
#
# A senha precisa estar codificada para URL (URL-encoded): caracteres como
# @, :, /, # e espaços precisam ser escapados. Exemplo de "@" numa senha: %40
#
# NUNCA coloque a senha real neste arquivo de exemplo.
DATABASE_URL=postgresql://eithra_dev_user:SENHA_URL_ENCODED@localhost:5432/eithra_dev

# ---------------------------------------------------------------------------
# E-mail local
# ---------------------------------------------------------------------------
# Sem definir EMAIL_BACKEND, o desenvolvimento continua imprimindo o e-mail no
# console. Para testar envio real localmente, preencha SMTP e sobrescreva o
# backend se necessário.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# ---------------------------------------------------------------------------
# Demais variáveis
# ---------------------------------------------------------------------------
# Chave, hosts e credenciais de storage continuam valendo como em .env.example:
# se algum recurso precisar delas, acrescente as linhas correspondentes aqui.
# Sem as credenciais de storage, o envio de arquivos é recusado — não há queda
# silenciosa para o disco local.
